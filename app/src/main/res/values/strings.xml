    <string name="perm_nearby_title">Nearby devices</string>
    <string name="perm_nearby_why">To reach phones near you without internet.</string>
    <string name="perm_nearby_denied">Without this, your phone cannot send or pass on alerts.</string>
    <string name="perm_location_title">Location</string>
    <string name="perm_location_why">To add where you are to your alert.</string>
    <string name="perm_location_denied">Alerts will have no location. On older phones, nearby phones cannot be found.</string>
    <string name="perm_notif_title">Notifications</string>
    <string name="perm_notif_why">To keep passing alerts with the screen off, and to show replies.</string>
    <string name="perm_notif_denied">You may miss replies, and relaying may stop in the background.</string>
    <string name="perm_mic_title">Microphone</string>
    <string name="perm_mic_why">To speak your message instead of typing.</string>
    <string name="perm_mic_denied">You can still type your message.</string>
    <string name="perm_bt_title">Bluetooth on</string>
    <string name="perm_bt_why">Nearby phones are reached over Bluetooth.</string>
    <string name="perm_bt_off">Bluetooth is off. Turn it on so nearby phones can reach you.</string>
    <string name="perm_locsvc_title">Location services on</string>
    <string name="perm_locsvc_why">Many phones need this to find other phones.</string>
    <string name="perm_locsvc_off">Location services are off. Turn them on so nearby phones can be found.</string>
    <string name="perm_battery_title">Allow background activity</string>
    <string name="perm_battery_why">Some phones stop apps in the background. Allow it so your phone keeps passing alerts with the screen off.</string>
    <string name="perm_battery_more">App battery settings</string>
    <string name="perm_battery_vivo">On vivo and iQOO phones, also open App battery settings and allow background activity.</string>


